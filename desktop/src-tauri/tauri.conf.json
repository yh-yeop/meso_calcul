{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "메소 계산기",
  "mainBinaryName": "meso-calcul",
  "version": "../package.json",
  "identifier": "io.github.yh-yeop.meso-calcul",
  "build": {
    "frontendDist": "https://yh-yeop.github.io/mesonomics/"
  },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "yh-yeop",
    "shortDescription": "메이플스토리 메소 장부 · 목표 도달일 · 보스 수익 계산기",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean"],
        "displayLanguageSelector": false
      }
    }
  }
}
